@startuml
title Confera - Framework e Template Method
interface EventInterface
interface ParticipantInterface
interface RegistrationInterface
class EventComponent
class ParticipantComponent
class RegistrationComponent
EventComponent ..|> EventInterface
ParticipantComponent ..|> ParticipantInterface
RegistrationComponent ..|> RegistrationInterface
abstract class EventFramework {
  +create_event(data): dict
  +validate(data): None
  {abstract} +configure(data): dict
}
class Secomp
class Symposium
EventFramework o-- EventComponent
Secomp --|> EventFramework
Symposium --|> EventFramework
note right of EventFramework::create_event
  Template Method:
  1. validate (frozen spot)
  2. configure (hotspot)
  3. EventComponent.create
end note
@enduml
